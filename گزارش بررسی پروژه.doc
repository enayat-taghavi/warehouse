<style>
  @page { size: A4; margin: 2.5cm 2cm; mso-page-orientation: portrait; }
  body { font-family: "Tahoma", "Segoe UI", sans-serif; direction: rtl; text-align: right; font-size: 11pt; line-height: 1.7; color: #1a1a1a; }
  h1 { font-size: 20pt; color: #1f3a5f; border-bottom: 3px solid #1f3a5f; padding-bottom: 8px; }
  h2 { font-size: 15pt; color: #1f3a5f; margin-top: 28px; border-bottom: 1px solid #c9d6e8; padding-bottom: 4px; }
  h3 { font-size: 12pt; color: #2e5285; margin-top: 18px; }
  table { border-collapse: collapse; width: 100%; font-size: 10pt; margin: 10px 0; }
  th { background: #1f3a5f; color: #fff; padding: 7px 9px; border: 1px solid #999; text-align: right; }
  td { padding: 6px 9px; border: 1px solid #bbb; vertical-align: top; }
  .crit { background: #fde8e8; color: #9b1c1c; font-weight: bold; }
  .high { background: #fef3e2; color: #92400e; font-weight: bold; }
  .med  { background: #fefce8; color: #854d0e; font-weight: bold; }
  .low  { background: #eef7ee; color: #14532d; font-weight: bold; }
