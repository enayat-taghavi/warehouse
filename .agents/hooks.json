{
  "repository-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
