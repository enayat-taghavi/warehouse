{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "attach-frontend",
      "url": "http://localhost:4200",
      "port": 4200
    },
    {
      "name": "backend-django",
      "runtimeExecutable": "backend\\venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "backend\\manage.py",
        "runserver",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend-angular-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--prefix",
        "frontend"
      ],
      "port": 4200
    },
    {
      "name": "frontend-prod-express",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "frontend\\server.js"
      ],
      "port": 4200
    },
    {
      "name": "attach-frontend-dev-4300",
      "url": "http://localhost:4300",
      "port": 4300
    },
    {
      "name": "frontend-dev-4300",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules\\@angular\\cli\\bin\\ng.js",
        "serve",
        "--proxy-config",
        "proxy.conf.json",
        "--port",
        "4300"
      ],
      "cwd": "frontend",
      "port": 4300
    }
  ]
}
