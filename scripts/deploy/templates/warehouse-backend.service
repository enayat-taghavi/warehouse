[Unit]
Description=Warehouse Daphne ASGI Backend Service
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service
# Set by a restore whose release does not match the schema; no start, restart or reboot runs it then.
ConditionPathExists=!/var/www/warehouse/shared/SERVICES_HELD

[Service]
Type=simple
User=warehouse
Group=warehouse
WorkingDirectory=/var/www/warehouse/current/backend
EnvironmentFile=/var/www/warehouse/shared/.env
ExecStart=/var/www/warehouse/current/venv/bin/python -m daphne -b 127.0.0.1 -p 8000 --proxy-headers config.asgi:application
Restart=always
RestartSec=3
LimitNOFILE=65535

# System Security & Sandboxing
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=/var/www/warehouse/shared

[Install]
WantedBy=multi-user.target
