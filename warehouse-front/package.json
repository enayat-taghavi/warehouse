{
  "name": "warehouse-app",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build && node tools/patch-ngsw-530.js",
    "build:accounting": "node tools/build-for-modules.js --modules=accounting",
    "build:warehouse": "node tools/build-for-modules.js --modules=warehouse",
    "build:modules": "node tools/build-for-modules.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:mobile": "ng build --configuration mobile && npx cap sync",
    "build:mobile-test": "ng build --configuration mobile-test && npx cap sync",
    "check:deps": "node tools/check-circular-deps.js"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-printer": "^8.1.8",
    "@capgo/capacitor-updater": "^8.53.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "chart.js": "^4.4.9",
    "compression": "^1.8.1",
    "dexie": "^4.4.4",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "jalali-ts": "^8.0.0",
    "ng-persian-datepicker": "^10.0.0",
    "pdfjs-dist": "^3.11.174",
    "puppeteer": "^25.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^26.6.5",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.5.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
