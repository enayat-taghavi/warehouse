{
  "name": "warehouse-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:accounting": "ng serve --proxy-config proxy.conf.json --configuration accounting-only",
    "start:warehouse": "ng serve --proxy-config proxy.conf.json --configuration warehouse-only",
    "build": "ng build && node tools/patch-ngsw-530.js",
    "build:accounting": "ng build --configuration accounting-only && node tools/patch-ngsw-530.js",
    "build:warehouse": "ng build --configuration warehouse-only && node tools/patch-ngsw-530.js",
    "build:modules": "node tools/build-for-modules.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:deps": "node tools/check-circular-deps.js"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.2",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "chart.js": "^4.4.9",
    "compression": "^1.8.1",
    "dexie": "^4.4.4",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "jalali-ts": "^8.0.0",
    "ng-persian-datepicker": "^10.0.0",
    "pdfjs-dist": "^3.11.174",
    "puppeteer": "^25.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.5.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
